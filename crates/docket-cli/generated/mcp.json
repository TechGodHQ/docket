        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "get_item"
    },
    {
      "description": "Append a new pending item. The producer boundary enforces design law (b): items must carry injected context, a recommendation, and a declarative action descriptor, or the create is rejected as a producer bug.\n",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action_operation": {
            "description": "Operation the target worker knows (e.g. merge_pr, send_email).",
            "type": "string"
          },
          "action_params": {
            "description": "JSON object of pass-through parameters for the target worker.",
            "type": "string"
          },
          "action_target": {
            "description": "Target worker for the action descriptor (e.g. hermes-coding, comms).",
            "type": "string"
          },
          "context": {
            "description": "Injected context the decider needs (markdown).",
            "type": "string"
          },
          "recommendation": {
            "description": "The recommended action, stated plainly.",
            "type": "string"
          },
          "source": {
            "description": "Producing source (e.g. plane, telegram, inbox).",
            "type": "string"
          },
          "title": {
            "description": "One-line summary.",
            "type": "string"
          }
        },
        "required": [
          "source",
          "title",
          "context",
          "recommendation",
          "action_target",
          "action_operation"
        ],
        "type": "object"
      },
      "name": "create_item"
    },
    {
      "description": "Append a decision to the item's decision log and move its status. Docket dispatches nothing here; the declarative action_descriptor is handed to the target worker by the dispatch layer (docket-6).\n",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "description": "Who decided (human or agent identity).",
            "type": "string"
          },
          "decision": {
            "description": "The decision (approve, dismiss, defer).",
            "type": "string"
          },
          "id": {
            "description": "Ledger item id (dkt-…).",
            "type": "string"
          },
          "new_status": {
            "description": "Resulting status (dispatched or dismissed; defaults to dispatched).",
            "type": "string"
          },
          "note": {
            "description": "Optional rationale.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "actor",
          "decision"
        ],
        "type": "object"
      },
      "name": "record_decision"
    }
  ]
